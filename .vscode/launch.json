    // 复合启动配置：一键启动多个服务
    // 使用方法：切换到「运行和调试」面板 → 顶部下拉框选择对应组合 → F5
    "compounds": [
        {
            "name": "🚀 全部服务（前端 + 后端）",
            "configurations": [
                "interface",
                "admin",
                "user_service",
                "order_service",
                "product_service",
                "marketing_service",
                "chat_service",
                "task",
                "blades",
                "nats",
                "rabbit",
                "web_cyi-mall (用户端前端)",
                "web_admin (管理后台前端)"
            ],
            "stopAll": true
        },
        {
            "name": "⚙️ 全部后端服务",
            "configurations": [
                "interface",
                "admin",
                "user_service",
                "order_service",
                "product_service",
                "marketing_service",
                "chat_service",
                "task",
                "blades",
                "nats",
                "rabbit"
            ],
            "stopAll": true
        },
        {
            "name": "🌐 仅前端",
            "configurations": [
                "web_cyi-mall (用户端前端)",
                "web_admin (管理后台前端)"
            ],
            "stopAll": true
        }
    ]
}