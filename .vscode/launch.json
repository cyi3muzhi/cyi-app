                "CONSUL_ADDR": "127.0.0.1:8500",
                "CONSUL_PATHS":"/local/common,/local/cyi-app/cin/interface",
                "SERVICE_ENV":"develop"
            }
        },
        {
            "name": "admin",
            "type": "go",
            "request": "launch",
            "mode": "auto",
