        },
        {
            "name": "web_cyi-mall (用户端前端)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/web/cyi-mall"
        },
        {
            "name": "web_admin (管理后台前端)",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/web/admin"
        }
