	rpc Update{{.ServiceNameTitle}} (Update{{.ServiceNameTitle}}Request) returns (Update{{.ServiceNameTitle}}Reply);
	rpc Delete{{.ServiceNameTitle}} (Delete{{.ServiceNameTitle}}Request) returns (Delete{{.ServiceNameTitle}}Reply);
	rpc Get{{.ServiceNameTitle}} (Get{{.ServiceNameTitle}}Request) returns (Get{{.ServiceNameTitle}}Reply);
	rpc List{{.ServiceNameTitle}} (List{{.ServiceNameTitle}}Request) returns (List{{.ServiceNameTitle}}Reply);
}

