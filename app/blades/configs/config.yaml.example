server:
  http:
    addr: 0.0.0.0:8000
    timeout: 30s
  grpc:
    addr: 0.0.0.0:9000
    timeout: 30s
data:
  redis:
    addr: redis:6379
    read_timeout: 0.2s
    write_timeout: 0.2s
    password: YOUR_REDIS_PASSWORD

trace:
  endpoint: jaeger:4318

log:
  level: info
  enable_console: true
  enable_file: false
  log_dir: logs
  time_format: "2006-01-02 15:04:05"
  enable_color: true

blades:
  api_key: YOUR_DEEPSEEK_API_KEY
  model: deepseek-v4-flash
  max_tokens: 4096
  temperature: 0.7
  embedding:
    api_key: YOUR_SILICONFLOW_API_KEY
    api_endpoint: "https://api.siliconflow.cn/v1"
    model: BAAI/bge-large-zh-v1.5
    dimension: 1024
  rag:
    top_k: 5
    chunk_size: 800
    chunk_overlap: 0.15
    always_retrieve: false
  knowledge:
    max_docs_per_source: 1000
