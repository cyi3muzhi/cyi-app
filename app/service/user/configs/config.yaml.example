server:
  http:
    addr: 0.0.0.0:8000
    timeout: 1s
  grpc:
    addr: 0.0.0.0:9000
    timeout: 1s
data:
  database:
    driver: mysql
    source: root:YOUR_MYSQL_PASSWORD@tcp(mysql:3306)/cin_test?parseTime=True&loc=Local
  redis:
    addr: redis:6379
    read_timeout: 0.2s
    write_timeout: 0.2s
    password: YOUR_REDIS_PASSWORD
  oss:
    endpoint: rustfs:9000
    access_key: YOUR_RUSTFS_ACCESS_KEY
    secret_key: YOUR_RUSTFS_SECRET_KEY

trace:
  endpoint: jaeger:4318

log:
  level: info
  enable_console: true
  enable_file: false
  log_dir: logs
  time_format: "2006-01-02 15:04:05"
  enable_color: true
